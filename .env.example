# --- Telegram ---
# Токен бота от @BotFather
BOT_TOKEN=

# Список Telegram ID, которым разрешён доступ (через запятую).
# Если пусто — доступ открыт всем (при условии пароля).
ALLOWED_USERS=

# Пароль для доступа к боту. Если пусто — пароль не требуется.
BOT_PASSWORD=

# --- MikroTik (RouterOS API) ---
MT_HOST=
MT_USER=admin
MT_PASS=
# Порт API: 8728 (без TLS) или 8729 (TLS)
MT_PORT=8728
# Использовать TLS (true/false). Для TLS нужен включённый api-ssl на роутере.
MT_USE_TLS=false

# --- WireGuard ---
# Имя интерфейса WireGuard на роутере
WG_INTERFACE=wg1
# Подсеть для выдачи клиентских IP (сервер обычно .1)
WG_SUBNET=10.10.0.0/24
# IP сервера в туннеле
WG_SERVER_ADDRESS=10.10.0.1
# Публичный адрес и порт сервера для конфигов клиентов, напр. 1.2.3.4:51820
WG_ENDPOINT=
# DNS для клиентских конфигов
WG_DNS=1.1.1.1, 8.8.8.8
